@model IEnumerable<DIS_Monher.Models.Material>

@{
    ViewData["Title"] = "Stock";
}

<h1>HU002: Actualizar Stock por Entradas y Salidas</h1>

<p>
    <a asp-action="Entrada" class="btn btn-success">Registrar Entrada</a>
    <a asp-action="Salida" class="btn btn-danger">Registrar Salida</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Codigo)</th>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.StockActual)</th>
            <th>@Html.DisplayNameFor(model => model.StockMinimo)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Codigo)</td>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td style="color: @(item.StockActual <= item.StockMinimo ? "red" : "green"); font-weight: bold;">
                    @Html.DisplayFor(modelItem => item.StockActual)
                </td>
                <td>@Html.DisplayFor(modelItem => item.StockMinimo)</td>
                <td>
                    <a asp-action="Historical" asp-route-id="@item.Id" class="btn btn-info btn-sm">Historial</a>
                </td>
            </tr>
        }
    </tbody>
</table>
