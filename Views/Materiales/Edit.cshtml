@model DIS_Monher.Models.Material
@{ ViewData["Title"] = "Editar material"; }

<div class="cabecera">
    <div>
        <h1 class="titulo">Editar material</h1>
        <p class="subtitulo">@Model.Codigo - registrado por @Model.UsuarioResponsable</p>
    </div>
</div>

<div class="panel form-panel">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="FechaIngreso" />
        <input type="hidden" asp-for="UsuarioResponsable" />
        <partial name="_Form" model="Model" />
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn-naranja">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-light">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
