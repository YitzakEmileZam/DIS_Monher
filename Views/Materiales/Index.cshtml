@model IEnumerable<DIS_Monher.Models.Material>

@{
    ViewData["Title"] = "Materiales";
}

<h1>HU001: Registrar Materiales e Insumos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Registrar Nuevo Material</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Codigo)</th>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Categoria)</th>
            <th>@Html.DisplayNameFor(model => model.UnidadMedida)</th>
            <th>@Html.DisplayNameFor(model => model.StockMinimo)</th>
            <th>@Html.DisplayNameFor(model => model.StockActual)</th>
            <th>@Html.DisplayNameFor(model => model.FechaIngreso)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Codigo)</td>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Categoria)</td>
                <td>@Html.DisplayFor(modelItem => item.UnidadMedida)</td>
                <td>@Html.DisplayFor(modelItem => item.StockMinimo)</td>
                <td style="color: @(item.StockActual <= item.StockMinimo ? "red" : "green"); font-weight: bold;">
                    @Html.DisplayFor(modelItem => item.StockActual)
                </td>
                <td>@Html.DisplayFor(modelItem => item.FechaIngreso)</td>
            </tr>
        }
    </tbody>
</table>
