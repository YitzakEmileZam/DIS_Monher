@model IEnumerable<DIS_Monher.Models.OrdenProduccion>

@{
    ViewData["Title"] = "Órdenes de producción";

    var enProceso = Model.Count(o => o.Estado == "En Proceso");
    var pendientes = Model.Count(o => o.Estado == "Pendiente");
    var terminadas = Model.Count(o => o.Estado == "Terminado");
    var canceladas = Model.Count(o => o.Estado == "Cancelado");
}

<div class="container py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Órdenes de producción</h2>
            <p class="text-muted mb-0">
                Consulta y administra las órdenes de producción.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Nueva orden
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }


    <ul class="nav nav-tabs mb-4" id="filtrosOrdenes">

        <li class="nav-item">
            <button class="nav-link active"
                    type="button"
                    data-estado="En Proceso">
                En proceso (@enProceso)
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link"
                    type="button"
                    data-estado="Pendiente">
                Pendientes (@pendientes)
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link"
                    type="button"
                    data-estado="Terminado">
                Terminadas (@terminadas)
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link"
                    type="button"
                    data-estado="Cancelado">
                Canceladas (@canceladas)
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link"
                    type="button"
                    data-estado="Todos">
                Todas (@Model.Count())
            </button>
        </li>

    </ul>


    <div class="row g-4" id="contenedorOrdenes">

        @foreach (var orden in Model)
        {
            var claseEstado = orden.Estado switch
            {
                "Pendiente" => "bg-warning text-dark",
                "En Proceso" => "bg-primary",
                "Terminado" => "bg-success",
                "Cancelado" => "bg-danger",
                _ => "bg-secondary"
            };

            var ultimoAvance = orden.Avances?
                .OrderByDescending(a => a.Fecha)
                .FirstOrDefault();

            var cantidadProducida =
                ultimoAvance?.CantidadProducida ?? 0;

            var porcentaje = orden.Cantidad > 0
                ? Math.Min(
                    100,
                    (int)Math.Round(
                        cantidadProducida * 100.0 / orden.Cantidad))
                : 0;

            if (orden.Estado == "Terminado")
            {
                porcentaje = 100;
                cantidadProducida = orden.Cantidad;
            }

            <div class="col-md-6 orden-card"
                 data-estado="@orden.Estado">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <!-- CABECERA DE TARJETA -->
                        <div class="d-flex justify-content-between align-items-start">

                            <div class="d-flex align-items-center gap-3">

                                <div class="bg-light text-primary fw-bold rounded px-3 py-3">
                                    OP
                                </div>

                                <div>
                                    <h5 class="mb-1">
                                        #@orden.NumeroOrden — @orden.TipoCaja
                                    </h5>

                                    <small class="text-muted">
                                        Inicio:
                                        @orden.Fecha.ToString("dd/MM/yyyy")
                                        ·
                                        Entrega:
                                        @orden.FechaEntrega.ToString("dd/MM/yyyy")
                                    </small>
                                </div>

                            </div>

                            <span class="badge rounded-pill @claseEstado">
                                @orden.Estado
                            </span>

                        </div>


                        <!-- PROGRESO -->
                        <div class="mt-4">

                            <div class="d-flex justify-content-between mb-2">

                                <small class="text-muted">
                                    Progreso
                                </small>

                                <small class="fw-semibold">
                                    @porcentaje%
                                    (@cantidadProducida / @orden.Cantidad unidades)
                                </small>

                            </div>

                            <div class="progress"
                                 style="height: 8px;">

                                <div class="progress-bar"
                                     role="progressbar"
                                     style="width: @porcentaje%"
                                     aria-valuenow="@porcentaje"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                </div>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <!-- INFORMACIÓN -->
                        <div class="row">

                            <div class="col-6">
                                <small class="text-muted text-uppercase d-block">
                                    Cliente
                                </small>

                                <strong>
                                    @orden.Cliente
                                </strong>
                            </div>

                            <div class="col-6">
                                <small class="text-muted text-uppercase d-block">
                                    Responsable
                                </small>

                                <strong>
                                    @orden.Responsable
                                </strong>
                            </div>

                        </div>

                    </div>


                    <!-- PIE -->
                    <div class="card-footer bg-white border-top px-4 py-3">

                        <div class="d-flex justify-content-between align-items-center">

                            <small class="text-muted">
                                @orden.Cantidad unidades solicitadas
                            </small>

                            <a asp-action="Details"
                               asp-route-id="@orden.Id"
                               class="text-decoration-none fw-semibold">
                                Ver detalles →
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>


    <!-- MENSAJE SIN RESULTADOS -->
    <div id="sinOrdenes"
         class="text-center py-5 text-muted d-none">


    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const botones =
                document.querySelectorAll("#filtrosOrdenes button");

            const tarjetas =
                document.querySelectorAll(".orden-card");

            const sinOrdenes =
                document.getElementById("sinOrdenes");


            function filtrar(estado) {

                let visibles = 0;

                tarjetas.forEach(card => {

                    const mostrar =
                        estado === "Todos" ||
                        card.dataset.estado === estado;

                    card.style.display =
                        mostrar ? "" : "none";

                    if (mostrar) {
                        visibles++;
                    }

                });

                sinOrdenes.classList.toggle(
                    "d-none",
                    visibles > 0
                );
            }


            botones.forEach(boton => {

                boton.addEventListener("click", function () {

                    botones.forEach(b =>
                        b.classList.remove("active")
                    );

                    this.classList.add("active");

                    filtrar(
                        this.dataset.estado
                    );

                });

            });

            filtrar("En Proceso");

        });

    </script>
}