@model IEnumerable<DIS_Monher.Models.Notificacion>

@{
    ViewData["Title"] = "Notificaciones";
}

<div class="container py-3">

    <div class="mb-4">
        <h2 class="mb-1">
            Notificaciones
        </h2>

        <p class="text-muted mb-0">
            Avisos generados para el área de distribución.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <h5 class="text-muted">
                    No hay notificaciones
                </h5>

                <p class="text-muted mb-0">
                    Las órdenes terminadas aparecerán aquí.
                </p>

            </div>
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var notificacion in Model)
            {
                <div class="col-12">

                    <div class="card border-0 shadow-sm">

                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between align-items-start">

                                <div class="me-4">

                                    <div class="d-flex align-items-center gap-2 mb-2">

                                        @if (notificacion.Leida)
                                        {
                                            <span class="badge bg-secondary">
                                                Leída
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Nueva
                                            </span>
                                        }

                                        <small class="text-muted">
                                            @notificacion.Fecha.ToString("dd/MM/yyyy HH:mm")
                                        </small>

                                    </div>

                                    <p class="mb-1 fw-semibold">
                                        @notificacion.Mensaje
                                    </p>

                                    <small class="text-muted">
                                        Área: @notificacion.Area
                                    </small>

                                </div>

                                @if (!notificacion.Leida)
                                {
                                    <form asp-action="MarcarLeida"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@notificacion.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-primary">
                                            Marcar como leída
                                        </button>

                                    </form>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>