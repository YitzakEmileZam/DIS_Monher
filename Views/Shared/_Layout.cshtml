<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MONHER</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/monher.css" asp-append-version="true" />
</head>
<body>
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => ctrl == c ? "active" : "";
    var esAdmin = User.IsInRole("Admin");
}
<div class="app">
    <aside class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">MONHER</a>
        <nav>
            @if (esAdmin)
            {
                <a class="@Active("Admin")" asp-controller="Admin" asp-action="Index">Panel</a>
                <a class="@Active("Materiales")" asp-controller="Materiales" asp-action="Index">Materiales</a>
                <span class="soon">Control de inventario</span>
                <span class="soon">Órdenes de producción</span>
                <span class="soon">Productos terminados</span>
                <span class="soon">Reportes</span>
            }
            else
            {
                <a class="@Active("Catalogo")" asp-controller="Catalogo" asp-action="Index">Catálogo</a>
                <span class="soon">Mis pedidos</span>
            }
        </nav>
    </aside>

    <div class="main">
        <header class="topbar">
            @if (esAdmin) { <span class="rol-chip">Administrador</span> }
            <partial name="_LoginPartial" />
        </header>
        <main class="content">
            @if (TempData["Ok"] != null)
            {
                <div class="alert alert-success">@TempData["Ok"]</div>
            }
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
